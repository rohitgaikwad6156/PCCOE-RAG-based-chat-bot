# ==========================================
# BACKEND ENVIRONMENT VARIABLES
# ==========================================
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database (MongoDB Atlas connection string, or leave empty for local development store)
MONGODB_URI=mongodb://localhost:27017/college-rag-chatbot

# Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# LLM Providers (Configure at least one for live LLM responses)
# Options for LLM_PROVIDER: gemini | openai | openrouter | mock
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL=gemini-1.5-flash

# Embedding Providers
# Options for EMBEDDING_PROVIDER: gemini | openai | local
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004

# Vector Database
# Options for VECTOR_STORE_PROVIDER: memory | pinecone | mongodb
VECTOR_STORE_PROVIDER=memory
PINECONE_API_KEY=
PINECONE_INDEX=college-rag
PINECONE_ENVIRONMENT=

# Initial Administrator Seed Credentials
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=AdminPassword123!
ADMIN_NAME=College Administrator

# ==========================================
# FRONTEND ENVIRONMENT VARIABLES
# ==========================================
VITE_API_URL=http://localhost:5000/api
