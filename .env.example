# ============================================================
# BACKEND ENVIRONMENT VARIABLES
# For Render deployment: set these in the Render dashboard
# For local development: copy to backend/.env (DO NOT COMMIT)
# ============================================================

NODE_ENV=development
PORT=5000

# Frontend origin (Vercel URL or localhost for dev)
FRONTEND_URL=http://localhost:5173

# ─── MongoDB Atlas ──────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pccoe-rag?retryWrites=true&w=majority

# ─── JWT Authentication ─────────────────────────────────────
# Generate a strong secret: openssl rand -base64 48
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# ─── Google OAuth 2.0 ───────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorized JavaScript origins: http://localhost:5173, https://your-frontend.vercel.app
# Authorized redirect URIs: (none needed for this flow)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── LLM Providers ──────────────────────────────────────────
# Choose one: openai | gemini | openrouter
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=gpt-4o-mini

# ─── Embedding Provider ──────────────────────────────────────
# Choose one: openai | gemini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# ─── Vector Database (Pinecone) ──────────────────────────────
VECTOR_STORE_PROVIDER=pinecone
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX=pccoe-rag
PINECONE_ENVIRONMENT=

# ─── PCCOE Admin Configuration ───────────────────────────────
# The admin account seeded on first startup
ADMIN_EMAIL=admin@pccoe.org
ADMIN_PASSWORD=YourSecureAdminPassword!
ADMIN_NAME=PCCOE Administrator

# Comma-separated list of Google emails that get admin role automatically
# SECURITY: Never expose this in client code
ADMIN_EMAILS=admin@pccoe.org

# ============================================================
# FRONTEND ENVIRONMENT VARIABLES
# For Vercel: set in Vercel project settings (Environment Variables)
# For local development: copy to frontend/.env (DO NOT COMMIT)
# ============================================================

# Backend API URL
VITE_API_URL=https://pccoe-rag-backend.onrender.com/api

# Google OAuth Client ID (ONLY the Client ID, never the secret)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
