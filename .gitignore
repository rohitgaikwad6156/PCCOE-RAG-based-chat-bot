# Dependencies
node_modules/
.pnp
.pnp.js

# Testing & Coverage
coverage/
.nyc_output/

# Production Build outputs
dist/
build/
.next/
out/

# Environment and Secrets — NEVER commit real .env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# But DO commit .env.example files (they contain no real values)
!.env.example
!backend/.env.example
!frontend/.env.example
*.pem

# Uploads and temporary files
backend/uploads/*
!backend/uploads/.gitkeep
uploads/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
