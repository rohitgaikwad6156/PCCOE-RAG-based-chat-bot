# ============================================================
# BACKEND ENVIRONMENT VARIABLES — backend/.env
# Copy this file to backend/.env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

NODE_ENV=development
PORT=5000

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:5173

# ─── MongoDB Atlas ──────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pccoe-rag?retryWrites=true&w=majority

# ─── JWT Authentication ─────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# ─── Google OAuth 2.0 ───────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── LLM Providers (openai | gemini | openrouter) ───────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=gemini-1.5-flash

# ─── Embedding Provider (openai | gemini) ───────────────────
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004

# ─── Vector Database (pinecone | memory) ────────────────────
VECTOR_STORE_PROVIDER=memory
PINECONE_API_KEY=
PINECONE_INDEX=pccoe-rag
PINECONE_ENVIRONMENT=

# ─── PCCOE Admin Configuration ───────────────────────────────
ADMIN_EMAIL=admin@pccoe.org
ADMIN_PASSWORD=YourSecureAdminPassword!
ADMIN_NAME=PCCOE Administrator

# Comma-separated emails that receive admin role on Google sign-in
ADMIN_EMAILS=admin@pccoe.org
