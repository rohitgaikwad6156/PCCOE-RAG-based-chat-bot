PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

MONGODB_URI=mongodb://localhost:27017/college-rag-chatbot
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# LLM Providers (gemini | openai | openrouter | mock)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Embeddings (gemini | openai | local)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004

# Vector Store (memory | pinecone | mongodb)
VECTOR_STORE_PROVIDER=memory
PINECONE_API_KEY=
PINECONE_INDEX=college-rag
PINECONE_ENVIRONMENT=

ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=AdminPassword123!
ADMIN_NAME=College Administrator
