# ============================================================
# FRONTEND ENVIRONMENT VARIABLES — frontend/.env
# Copy this file to frontend/.env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

# Backend API base URL
# Local development:
VITE_API_URL=http://localhost:5000/api
# Production (uncomment for Vercel):
# VITE_API_URL=https://pccoe-rag-backend.onrender.com/api

# Google OAuth Client ID (public — safe to expose in frontend)
# Create at: https://console.cloud.google.com/apis/credentials
# Add authorized JavaScript origins:
#   - http://localhost:5173 (local dev)
#   - https://your-project.vercel.app (production)
# DO NOT put GOOGLE_CLIENT_SECRET here — backend-only secret
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
